# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max
# ANTHROPIC_ENABLE_FALLBACKS=true  # server-side refusal fallbacks

# ---- Slack (Socket Mode) ---------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# SLACK_COMMAND=/agent-release

# ---- Agent source -----------------------------------------------------------
AGENT_SOURCE=github
# Comma-separated GitHub repo URLs containing SFDX projects with Agentforce agents.
# A /tree/<branch> suffix pins the branch.
GITHUB_REPOS=https://github.com/<owner>/<repo>
# GITHUB_BRANCH=main
# Required for private repos (fine-grained token, Contents: read-only)
GITHUB_TOKEN=

# ---- Release notes (primary evidence) ----------------------------------------
# Every agent is assessed strictly against this release's official notes.
# "latest" = current release according to help.salesforce.com (auto-follows new releases),
# or pin one, e.g. TARGET_RELEASE=Winter '27
TARGET_RELEASE=latest
# Each release's document is downloaded once and reused; a new download happens only when
# help.salesforce.com reports a different latest release (force with: cli notes fetch latest --refresh).
# Manual fallbacks (only needed if the automatic export ever fails):
#   a folder with the PDF saved via the PDF button, or a direct link "Winter '27=https://...pdf"
RELEASE_NOTES_DIR=release_notes
# RELEASE_NOTES_PDF_URLS=

# ---- How the release notes are read ------------------------------------------
# Every page of the release notes is read. Topics given preference (read first, listed first):
# PRIORITY_TOPICS=Agentforce,Agent Script,AIforce,Claude,Einstein,Generative AI,AI,LLM,large language model,Prompt Builder,prompt template,Model Context Protocol,MCP,Atlas Reasoning,agent action,Data 360,Data Cloud,retriever,Trust Layer
# A section/chunk becomes a priority one at this many topic mentions per page (title matches always count):
# PRIORITY_DENSITY=5
# SCAN_CHUNK_TOKENS=60000     # size of each chunk sent to Claude
# SCAN_CONCURRENCY=4          # chunks read in parallel
# Model / effort for non-priority chunks (default: same as ANTHROPIC_MODEL / ANTHROPIC_EFFORT):
# SCAN_MODEL=claude-opus-5
# SCAN_EFFORT=high

# ---- Agent dependency scan ---------------------------------------------------
# Every file the agent depends on (transitively) plus permission sets / triggers / tests wired to it.
# Files beyond this budget are listed in the report, never dropped silently:
# DEPENDENCY_MAX_CHARS=1500000

# ---- Network ------------------------------------------------------------------
# Hosts an explicit RELEASE_NOTES_PDF_URLS link may point to:
# ALLOWED_SOURCE_DOMAINS=help.salesforce.com,developer.salesforce.com,releasenotes.docs.salesforce.com,resources.docs.salesforce.com,trust.salesforce.com,status.salesforce.com
# USE_SYSTEM_CERTS=true   # use the OS certificate store (corporate proxies)

# ---- Misc -------------------------------------------------------------------
# CACHE_TTL_HOURS=24
# MAX_CONCURRENT_ANALYSES=3
